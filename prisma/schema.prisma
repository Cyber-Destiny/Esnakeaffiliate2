// ENSNAKE Affiliate System - Prisma Schema
// Provider: SQLite (sandbox constraint). Money stored as Float for simplicity in demo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Platform-wide constants are managed in code (src/lib/constants.ts):
//   PLATFORM_FEE_PCT = 10  (platform revenue = feePct * wager)
//   DEFAULT_COMMISSION_PCT = 20 (affiliate earns commissionPct of platform revenue)

model Affiliate {
  id            String   @id @default(cuid())
  fullName      String
  email         String   @unique
  username      String   @unique
  passwordHash  String
  referralCode  String   @unique
  commissionPct Float    @default(20) // % of platform revenue paid to affiliate
  status        String   @default("active") // active | suspended | pending
  role          String   @default("affiliate") // affiliate | admin
  emailVerified Boolean  @default(false)
  avatarUrl     String?
  platformName  String? // e.g. TikTok, YouTube, Twitch
  bio           String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clicks        Click[]
  referredUsers ReferredUser[]
  withdrawals   Withdrawal[]
  payouts       Payout[]
  notifications Notification[]
}

model ReferredUser {
  id                  String   @id @default(cuid())
  username            String
  email               String?
  affiliateId         String
  referralCode        String
  deposited           Float    @default(0)
  totalWagered        Float    @default(0)
  revenueGenerated    Float    @default(0) // platform revenue generated
  commissionGenerated Float    @default(0)
  status              String   @default("active") // active | dormant
  joinedAt            DateTime @default(now())

  affiliate           Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  deposits            Deposit[]
  wagers              Wager[]
}

model Click {
  id           String   @id @default(cuid())
  affiliateId  String
  referralCode String
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  affiliate    Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
}

model Deposit {
  id             String   @id @default(cuid())
  referredUserId String
  amount         Float
  createdAt      DateTime @default(now())

  referredUser   ReferredUser @relation(fields: [referredUserId], references: [id], onDelete: Cascade)
}

model Wager {
  id              String   @id @default(cuid())
  referredUserId  String
  amount          Float // total wager
  platformRevenue Float   @default(0) // platform fee portion (feePct * wager)
  commission      Float   @default(0) // affiliate commission (commissionPct of platformRevenue)
  createdAt       DateTime @default(now())

  referredUser    ReferredUser @relation(fields: [referredUserId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id            String   @id @default(cuid())
  affiliateId   String
  amount        Float
  bankName      String
  accountNumber String
  accountName   String
  status        String   @default("pending") // pending | approved | rejected
  transactionId String?
  note          String?
  createdAt     DateTime @default(now())
  processedAt   DateTime?

  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
}

model Payout {
  id            String   @id @default(cuid())
  affiliateId   String
  amount        Float
  status        String   @default("completed") // completed | pending | failed
  transactionId String
  method        String   @default("bank_transfer")
  createdAt     DateTime @default(now())

  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  affiliateId String
  type        String // signup | deposit | withdrawal_requested | withdrawal_approved | withdrawal_rejected | system
  title       String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  purpose   String // email_verification | password_reset
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
